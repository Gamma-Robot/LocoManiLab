# Copy this into a workspace as env.local.yaml, or use `lab init <directory>`.
# This file contains portable examples only. Do not commit your local copy.
schema_version: 2
role: [data]
# workspace_root: .  # optional; defaults to the directory containing this config

# Optional model/runtime checkouts. Omit unused keys. Relative paths are workspace-relative.
repos: {}
# Example:
# repos:
#   lerobot: ../LocoManiLab/external/lerobot
#   opendm: ../LocoManiLab/external/opendm
#   sim_repo: ../LocoManiLab/external/humanoid_benchmark
#   g1_backend: ../LocoManiLab/external/g1_backend
#   gr00t_wbc: ../LocoManiLab/external/GR00T-WholeBodyControl  # Real-robot deployment only.

# Local checkpoints, converted datasets, and outputs; use env variables for shared storage.
paths: {}
# Example:
# paths:
#   lerobot_data_root: datasets/lerobot
#   lerobot_outputs: outputs/lerobot
#   gr00t_model: ${MODELS_DIR}/gr00t/checkpoint
#   gr00t_base: ${MODELS_DIR}/gr00t/base

# Runtime endpoints belong to your local setup. Check the selected runtime's port convention.
deploy: {}
# deploy:
#   camera_host: 127.0.0.1
#   policy_port: 5550

# Most heavy environments are provisioned in their own repositories.
# conda_root: ~/miniconda3  # only if you use a conda-backed model
conda_envs: {}
# conda_envs:
#   data: data-tools  # optional alternate environment for prepare
